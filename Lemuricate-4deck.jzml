<VARIABLE name="deckLevel=0" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Container4/FaderContainer1A/deckLevel" midi_target="-1" midi_trigger="1" midi_message="0xBA,0xBA,2,2" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="3819,1,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="onDeckLevel()" script="decl lvl;
decl i;

decl lowSegs = 6;
decl midSegs = 3;
decl hiSegs  = 3;

decl lowLvl, midLvl, hiLvl;

lvl = clamp(deckLevel / 127, 0, 1);

/* split into bands */
lowLvl = clamp(lvl / 0.5, 0, 1);
midLvl = clamp((lvl - 0.5) / 0.3, 0, 1);
hiLvl  = clamp((lvl - 0.8) / 0.2, 0, 1);

/* LOW LED (6 segments) */
for (i = 0; i < lowSegs; i++)
{
    Low_1.value[lowSegs - 1 - i] = (lowLvl > (i / lowSegs)) ? 1 : 0;
}

/* MID LED (3 segments) */
for (i = 0; i < midSegs; i++)
{
    Mid_1.value[midSegs - 1 - i] = (midLvl > (i / midSegs)) ? 1 : 0;
}

/* HIGH LED (3 segments) */
for (i = 0; i < hiSegs; i++)
{
    High_1.value[hiSegs - 1 - i] = (hiLvl > (i / hiSegs)) ? 1 : 0;
}
" trigger_script="deckLevel" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/FaderContainer1A/onDeckLevel" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

<VARIABLE name="m1=0" send="0" osc_target="0" osc_trigger="1" osc_message="/MstrContainer/m1" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="m2=0" send="0" osc_target="0" osc_trigger="1" osc_message="/MstrContainer/m2" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="m3=0" send="0" osc_target="0" osc_trigger="1" osc_message="/MstrContainer/m3" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="m4=0" send="0" osc_target="0" osc_trigger="1" osc_message="/MstrContainer/m4" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="hdrBpm=0" send="0" osc_target="0" osc_trigger="1" osc_message="/MstrContainer/hdrBpm" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="onMasterLevel()" script="decl lvlL, lvlR;
decl lowL, midL, highL;
decl lowR, midR, highR;

lvlL = masterLevel_L / 127;
lvlR = masterLevel_R / 127;

lvlL = clamp(lvlL, 0, 1);
lvlR = clamp(lvlR, 0, 1);

lowL  = clamp(lvlL / 0.33, 0, 1);
midL  = clamp((lvlL - 0.33) / 0.33, 0, 1);
highL = clamp((lvlL - 0.66) / 0.34, 0, 1);

lowR  = clamp(lvlR / 0.33, 0, 1);
midR  = clamp((lvlR - 0.33) / 0.33, 0, 1);
highR = clamp((lvlR - 0.66) / 0.34, 0, 1);

mstrLow_L.value  = lowL;
mstrMid_L.value  = midL;
mstrHigh_L.value = highL;

mstrLow_R.value  = lowR;
mstrMid_R.value  = midR;
mstrHigh_R.value = highR;
" trigger_script="masterLevel" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/MstrContainer/onMasterLevel" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="onMeter1(OSC_ARGS)" script="// Channel level from Syndicate (0 to 1). Feeds this strip's meter, and the master
// meter shows the loudest of the four channels.
m1 = OSC_ARGS[0];
AppContainer.Container.FaderContainer1A.deckLevel = m1 * 127;
masterLevel_L = max(max(m1, m2), max(m3, m4)) * 127;
masterLevel_R = masterLevel_L;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Mixer/CH1/Meter" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onMeter2(OSC_ARGS)" script="// Channel 2 level. See onMeter1.
m2 = OSC_ARGS[0];
AppContainer.Container5.FaderContainer1A.deckLevel = m2 * 127;
masterLevel_L = max(max(m1, m2), max(m3, m4)) * 127;
masterLevel_R = masterLevel_L;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Mixer/CH2/Meter" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onMeter3(OSC_ARGS)" script="// Channel 3 level. See onMeter1.
m3 = OSC_ARGS[0];
AppContainer.Container4.FaderContainer1A.deckLevel = m3 * 127;
masterLevel_L = max(max(m1, m2), max(m3, m4)) * 127;
masterLevel_R = masterLevel_L;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Mixer/CH3/Meter" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onMeter4(OSC_ARGS)" script="// Channel 4 level. See onMeter1.
m4 = OSC_ARGS[0];
AppContainer.Container6.FaderContainer1A.deckLevel = m4 * 127;
masterLevel_L = max(max(m1, m2), max(m3, m4)) * 127;
masterLevel_R = masterLevel_L;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Mixer/CH4/Meter" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onHeaderBpm(OSC_ARGS)" script="// Master BPM. Passed down to each deck; synced decks display it.
hdrBpm = OSC_ARGS[0];
AppContainer.Player1.hdrBpm = hdrBpm;
if (AppContainer.Player1.syncOn) AppContainer.Player1.BPM.value = hdrBpm;
AppContainer.Player2.hdrBpm = hdrBpm;
if (AppContainer.Player2.syncOn) AppContainer.Player2.BPM.value = hdrBpm;
AppContainer.Player3.hdrBpm = hdrBpm;
if (AppContainer.Player3.syncOn) AppContainer.Player3.BPM.value = hdrBpm;
AppContainer.Player4.hdrBpm = hdrBpm;
if (AppContainer.Player4.syncOn) AppContainer.Player4.BPM.value = hdrBpm;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Header/BPM" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="askResend()" script="// On load, ask Syndicate to send everything again so titles, BPM, cues and waveforms appear.
// Needs Lemur OSC target 1 pointing at the Mac, port 9090, and Syndicate's OSC input on.
oscout(1, '/Syndicate/Feedback/Resend', 1);" trigger_script="" trigger_type="5" trigger="1" clock="0" clock_div="4" osc_message="/MstrContainer/askResend" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

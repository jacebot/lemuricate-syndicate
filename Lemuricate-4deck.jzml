if (ResetReso.x) RESO.x = defReso;" trigger_script="ResetReso.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container5/Container1A/doResetReso" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

<SCRIPT name="killLo()" script="// EQ kill: remember the knob, drop it to zero; on release put it back.
if (Low_kill_1.x) { if (kLo == 0) { sLo = LO.x; kLo = 1; LO.x = 0; } }
else { if (kLo == 1) { kLo = 0; LO.x = sLo; } }" trigger_script="Low_kill_1.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container4/killLo" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="killLoOff()" script="if (Low_kill_1.x) { if (kLo == 0) { sLo = LO.x; kLo = 1; LO.x = 0; } }
else { if (kLo == 1) { kLo = 0; LO.x = sLo; } }" trigger_script="1 - Low_kill_1.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container4/killLoOff" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="killMid()" script="// EQ kill: remember the knob, drop it to zero; on release put it back.
if (Mid_kill_1.x) { if (kMid == 0) { sMid = MID.x; kMid = 1; MID.x = 0; } }
else { if (kMid == 1) { kMid = 0; MID.x = sMid; } }" trigger_script="Mid_kill_1.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container4/killMid" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="killMidOff()" script="if (Mid_kill_1.x) { if (kMid == 0) { sMid = MID.x; kMid = 1; MID.x = 0; } }
else { if (kMid == 1) { kMid = 0; MID.x = sMid; } }" trigger_script="1 - Mid_kill_1.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container4/killMidOff" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="killHi()" script="// EQ kill: remember the knob, drop it to zero; on release put it back.

<VARIABLE name="artist=''" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player4/Container/Canvas/artist" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="tkey=''" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player4/Container/Canvas/tkey" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="wave=0" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player4/Container/Canvas/wave" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="seekLast=0" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player4/Container/Canvas/seekLast" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="draw()" script="// Draws the deck display: waveform bars (blue = played, gray = to come, red = last 30 s),
// or a plain progress bar when no waveform has arrived, then the playhead and the key.
decl c = getobject();
decl r = getattribute(c, 'rect');
decl w = r[2];
decl h = r[3];
decl n = sizeof(wave);
decl left = dur * (1 - prog);
decl i, a, bw, k, mid;
canvas_clear(c);
canvas_setFillStyle(c, {0.08, 0.08, 0.1});
canvas_fillRect(c, 0, 0, w, h);
mid = h * 0.5;
if (n > 1) {
  bw = w / n;
  k = floor(prog * n);
  canvas_setFillStyle(c, {0.25, 0.62, 1});
  for (i = 0; k > i; i++) { a = wave[i] * h * 0.46; canvas_fillRect(c, i * bw, mid - a, bw * 0.75 + 0.5, a * 2 + 1); }
  canvas_setFillStyle(c, {0.5, 0.5, 0.55});
  if (dur > 0) { if (30 > left) canvas_setFillStyle(c, {0.85, 0.25, 0.15}); }
  for (i = k; n > i; i++) { a = wave[i] * h * 0.46; canvas_fillRect(c, i * bw, mid - a, bw * 0.75 + 0.5, a * 2 + 1); }
}
else {
  canvas_setFillStyle(c, {0.1, 0.42, 0.72});
  if (dur > 0) { if (30 > left) canvas_setFillStyle(c, {0.75, 0.15, 0.1}); }
  canvas_fillRect(c, 0, 0, w * prog, h);
}
canvas_setFillStyle(c, {1, 1, 1});
canvas_fillRect(c, w * prog - 1, 0, 2, h);
canvas_setTextBaseline(c, 1);
canvas_setFillStyle(c, {0.85, 0.85, 0.85});
canvas_setFontSize(c, 13);
canvas_fillText(c, tkey, 6, h * 0.85, w - 12);" trigger_script="" trigger_type="255" trigger_name="onRedraw" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Player4/Container/Canvas/draw" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="onCursorDown(cursor,hit,x,y)" script="// Touch to seek: jump the deck to where the finger lands.
// Sent both as OSC (target 1) and as MIDI (channel 16) so either route can do the seek.
decl r = getattribute(getobject(), 'rect');
decl p = max(0, min(1, x / r[2]));
seekLast = p; prog = p;
oscout(1, '/Syndicate/Deck/4/WaveformSeek', p);
midiout(0, {0xBF, 4, round(p * 127)});
canvas_refresh(getobject());" trigger_script="" trigger_type="255" trigger_name="onCursorDown" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Player4/Container/Canvas/onCursorDown" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="onCursorMove(cursor,hit,x,y)" script="// Drag to scrub. Only sends when the finger has moved a little, to avoid flooding Syndicate.
decl r = getattribute(getobject(), 'rect');
decl p = max(0, min(1, x / r[2]));
if (abs(p - seekLast) > 0.003) {
  seekLast = p; prog = p;
  oscout(1, '/Syndicate/Deck/4/WaveformSeek', p);
midiout(0, {0xBF, 4, round(p * 127)});
  canvas_refresh(getobject());
}" trigger_script="" trigger_type="255" trigger_name="onCursorMove" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Player4/Container/Canvas/onCursorMove" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

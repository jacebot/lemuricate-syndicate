<SCRIPT name="doResetCutoff()" script="// Reset button: put the knob back to its default (see the def* variables).
if (ResetCutoff.x) CUTOFF.x = defCutoff;" trigger_script="ResetCutoff.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container1A/doResetCutoff" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="doResetCutoffB()" script="if (ResetCutoff.x) CUTOFF.x = defCutoff;" trigger_script="1 - ResetCutoff.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container1A/doResetCutoffB" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="doResetReso()" script="// Reset button: put the knob back to its default (see the def* variables).
if (ResetReso.x) RESO.x = defReso;" trigger_script="ResetReso.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container1A/doResetReso" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="doResetResoB()" script="if (ResetReso.x) RESO.x = defReso;" trigger_script="1 - ResetReso.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container1A/doResetResoB" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="doResetWidth()" script="// Reset button: put the knob back to its default (see the def* variables).
if (ResetWidth.x) WIDTH.x = defWidth;" trigger_script="ResetWidth.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container1A/doResetWidth" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="doResetWidthB()" script="if (ResetWidth.x) WIDTH.x = defWidth;" trigger_script="1 - ResetWidth.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container4/Container1A/doResetWidthB" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>
</WINDOW>

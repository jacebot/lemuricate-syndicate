if (ResetWidth.x) WIDTH.x = defWidth;" trigger_script="ResetWidth.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container/Container1A/doResetWidth" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

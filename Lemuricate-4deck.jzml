<VARIABLE name="hdrBpm=0" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player1/hdrBpm" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="lastSec=-1" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player1/lastSec" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="playState=0" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player1/playState" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="tsVal=0.5" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/Player1/tsVal" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="onTrackInfo(OSC_ARGS)" script="// A track was loaded: Syndicate sends title, artist, key, BPM, length, bars, beats, type.
// Update the title, hand the details to the canvas and show the right BPM.
Container.Canvas.title = OSC_ARGS[0];
Container.Canvas.artist = OSC_ARGS[1];
Container.Canvas.tkey = OSC_ARGS[2];
Container.Canvas.dur = OSC_ARGS[4];
if (OSC_ARGS[1] == '') setattribute(Container.Text, 'content', OSC_ARGS[0]);
else setattribute(Container.Text, 'content', OSC_ARGS[0] + ' - ' + OSC_ARGS[1]);
trackBpm = OSC_ARGS[3];
lastSec = -1;
BPM.value = (syncOn * (hdrBpm > 0)) ? hdrBpm : trackBpm;
canvas_refresh(Container.Canvas);" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/TrackInfo" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onWave(OSC_ARGS)" script="// Waveform from the Mac bridge: a list of bar heights between 0 and 1.
Container.Canvas.wave = OSC_ARGS;
canvas_refresh(Container.Canvas);" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/Wave" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onProgress(OSC_ARGS)" script="// Playhead position (0 to 1). Moves the canvas playhead and updates the -mm:ss counter,
// which flashes red/white once a second in the last 30 seconds.
decl p = OSC_ARGS[0];
decl r = floor(Container.Canvas.dur * (1 - p));
decl mm, ss, t;
Container.Canvas.prog = p;
canvas_refresh(Container.Canvas);
if (r != lastSec) {
  lastSec = r;
  mm = floor(r / 60);
  ss = r - mm * 60;
  if (10 > mm) t = '-0' + mm; else t = '-' + mm;
  if (10 > ss) t = t + ':0' + ss; else t = t + ':' + ss;
  setattribute(REMIAIN, 'content', t);
  if ((Container.Canvas.dur > 0) * (30 > r)) setattribute(REMIAIN, 'color', (r % 2) ? 16723504 : 16777215);
  else setattribute(REMIAIN, 'color', 8347171);
}" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/Progress" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onBPM(OSC_ARGS)" script="// The track's original BPM. When synced we show the master BPM instead.
trackBpm = OSC_ARGS[0];
BPM.value = (syncOn * (hdrBpm > 0)) ? hdrBpm : trackBpm;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/BPM" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onPlaying(OSC_ARGS)" script="// Syndicate's real play state drives the button, so the icon is always right.
playState = OSC_ARGS[0];
PlayButton.x = playState;
PlayButton.light = playState;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/Playing" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onCues(OSC_ARGS)" script="// Which of the 8 hot cue slots are set (slot number or 0, then the cue name).
// Set slots light dimly in Syndicate's slot color, empty ones go dark gray.
setattribute(Roll1.CustomButton11, 'color', {OSC_ARGS[0] ? 6758171 : 3355443, 15156797});
setattribute(Roll1.CustomButton12, 'color', {OSC_ARGS[2] ? 7094038 : 3355443, 15895602});
setattribute(Roll1.CustomButton14, 'color', {OSC_ARGS[4] ? 7495976 : 3355443, 16767066});
setattribute(Roll1.CustomButton15, 'color', {OSC_ARGS[6] ? 7104602 : 3355443, 15919560});
setattribute(Roll1.CustomButton13, 'color', {OSC_ARGS[8] ? 2707294 : 3355443, 6140369});
setattribute(Roll1.CustomButton16, 'color', {OSC_ARGS[10] ? 1519181 : 3355443, 3499949});
setattribute(Roll1.CustomButton17, 'color', {OSC_ARGS[12] ? 2958399 : 3355443, 6640269});
setattribute(Roll1.CustomButton18, 'color', {OSC_ARGS[14] ? 2309686 : 3355443, 5147512});" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/Cues" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="playTouch()" script="// A tap flips the button away from the real state. When that happens, send one
// play/pause press. Syndicate answers with the new state and onPlaying lines it back up.
if (PlayButton.x != playState) {
  midiout(0, {0xB0, 19, 127}); midiout(0, {0xB0, 19, 0});
}" trigger_script="PlayButton.x != playState" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Player1/playTouch" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
<SCRIPT name="onSync(OSC_ARGS)" script="// Sync state. While synced, show the master BPM and gray out the locked pitch fader.
SyncButton.light = OSC_ARGS[0];
syncOn = OSC_ARGS[0];
BPM.value = (syncOn * (hdrBpm > 0)) ? hdrBpm : trackBpm;
setattribute(Fader, 'color', syncOn ? 5592405 : 7044899);" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/Sync" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="onTempoSlider(OSC_ARGS)" script="// Pitch fader position from Syndicate (-1 to +1). Ignored while a finger is on the fader.
tsVal = (OSC_ARGS[0] + 1) / 2;
if (Fader.z == 0) Fader.x = tsVal;" trigger_script="" trigger_type="2" trigger="1" clock="0" clock_div="4" osc_message="/Syndicate/Deck/1/TempoSlider" midi_message="0x90,0x90,0,0" midi_target="-1" flag="9"/>
<SCRIPT name="tempoRelease()" script="// On release, snap the fader to Syndicate's value (matters when Sync has it locked).
if (Fader.z == 0) Fader.x = tsVal;" trigger_script="Fader.z" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Player1/tempoRelease" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

<SCRIPT name="doResetCutoff()" script="// Reset button: put the knob back to its default (see the def* variables).
if (ResetCutoff.x) CUTOFF.x = defCutoff;" trigger_script="ResetCutoff.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container/Container1A/doResetCutoff" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>

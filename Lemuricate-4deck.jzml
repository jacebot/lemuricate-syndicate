<VARIABLE name="n=0" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/BrowseDial/n" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<VARIABLE name="step=0.04" send="0" osc_target="0" osc_trigger="1" osc_message="/AppContainer/BrowseDial/step" midi_target="-1" midi_trigger="1" midi_message="0x90,0x90,0,0" midi_scale="0,16383" kbmouse_target="-1" kbmouse_trigger="1" kbmouse_message="0,0,0" kbmouse_scale="0,1,0,1"/>
<SCRIPT name="browse()" script="// Endless browse dial: every 'step' of rotation sends one Browser Down (clockwise)
// or Up (counter-clockwise) press. Capped at 8 presses per movement.
acc = acc + (x - lastX);
lastX = x;
n = 0;
while (acc >= step) {
  midiout(0, {0xB0, 63, 127}); midiout(0, {0xB0, 63, 0});
  acc = acc - step; n = n + 1;
  if (n >= 8) acc = 0;
}
while (0 >= acc + step) {
  midiout(0, {0xB0, 60, 127}); midiout(0, {0xB0, 60, 0});
  acc = acc + step; n = n + 1;
  if (n >= 8) acc = 0;
}" trigger_script="x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/BrowseDial/browse" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
</WINDOW>

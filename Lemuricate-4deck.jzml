else { if (kHi == 1) { kHi = 0; HI.x = sHi; } }" trigger_script="1 - Hi_kill_1.x" trigger_type="0" trigger="1" clock="0" clock_div="4" osc_message="/AppContainer/Container5/Container4/killHiOff" midi_message="0x90,0x90,0,0" midi_target="-1" flag="1"/>
